+// files opt-in v1: only a registered application's own window delegates DnD.
+// FLTK still owns these offer proxies; the application owns a DIFFERENT device.
+// Default windows keep the upstream path unchanged. No foreign listener swap.
+typedef int (*Files_Dnd_Delegate_V1)(Fl_Window *);
+static Files_Dnd_Delegate_V1 files_dnd_delegate_v1 = NULL;
+static struct wl_data_offer *files_delegated_offer = NULL;
+static bool files_delegated_sequence = false;
+
+static void files_release_delegated_offer() {
+  if (files_delegated_offer) {
+    wl_data_offer_destroy(files_delegated_offer);
+    files_delegated_offer = NULL;
+  }
+}
+
+extern "C" int fl_files_set_dnd_delegate_v1(Files_Dnd_Delegate_V1 delegate) {
+  files_dnd_delegate_v1 = delegate;
+  // Unregister may happen on close/seat loss without leave/drop. Release only
+  // the FLTK-owned delegated proxy. Keep sequence suppression until next enter:
+  // late motion/drop must never restart upstream reads on the old drag.
+  if (!delegate) files_release_delegated_offer();
+  return 1;
+}
