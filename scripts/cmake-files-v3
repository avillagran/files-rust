#!/usr/bin/env python3
"""Forward cmake argv; inject one repo source ONLY for pinned cfltk configure."""
import os
from pathlib import Path
import re
import shutil
import sys

args = sys.argv[1:]
real = os.environ.get('FILES_REAL_CMAKE') or shutil.which('cmake')
if not real or Path(real).resolve() == Path(__file__).resolve():
    sys.exit('files CMake wrapper: real cmake executable unavailable')
source = None
if '-S' in args:
    index = args.index('-S') + 1
    if index < len(args):
        source = Path(args[index])
elif args and not args[0].startswith('-'):
    source = Path(args[0])
if source is not None and source.name == 'cfltk':
    manifest = source / 'CMakeLists.txt'
    if manifest.is_file():
        with manifest.open() as stream:
            header = stream.read(4096)
        if re.search(r'set\(CFLTK_PROJECT_VERSION\s+1\.5\.23\)', header):
            hook = Path(__file__).resolve().parent.parent / 'native/fltk/inject-v1.cmake'
            if any(a.startswith('-DCMAKE_PROJECT_INCLUDE') for a in args):
                sys.exit('files CMake wrapper: explicit project include needs deliberate hook composition')
            args.append('-DCMAKE_PROJECT_INCLUDE=' + str(hook))
os.execv(real, [real, *args])
