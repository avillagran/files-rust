include("${CMAKE_CURRENT_LIST_DIR}/contract-v1.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/keymap-v1.cmake")
files_dnd_contract("${FILES_REPO}" stamp source)
set(matched FALSE)
foreach(config IN LISTS FILES_CONFIGS)
  get_filename_component(build "${config}" DIRECTORY)
  set(generated "${build}/files-wayland-transfer/fl_wayland_clipboard_dnd.cxx")
  set(upstream_screen "${build}/files-wayland-keymap/upstream-Fl_Wayland_Screen_Driver.cxx")
  set(generated_screen "${build}/files-wayland-keymap/Fl_Wayland_Screen_Driver.cxx")
  if(EXISTS "${generated}" AND EXISTS "${upstream_screen}" AND EXISTS "${generated_screen}")
    file(READ "${generated}" actual)
    file(READ "${upstream_screen}" upstream)
    files_keymap_source("${FILES_REPO}" "${upstream}" "${stamp}" expected_screen)
    file(READ "${generated_screen}" actual_screen)
    if(actual STREQUAL source AND actual_screen STREQUAL expected_screen)
      set(matched TRUE)
    endif()
  endif()
endforeach()
if(NOT matched)
  message(FATAL_ERROR "files DnD stale/missing generated build input. Bump BOTH versioned CMAKE wrapper and CFLTK_TOOLCHAIN paths in .cargo/config.toml to force the pinned fltk-sys configure; do not edit the registry or bypass this guard.")
endif()
file(WRITE "${FILES_HEADER}" "// Generated build-input link guard; no runtime hash I/O.\n#define FILES_FLTK_DND_INPUT_SYMBOL fl_files_dnd_input_${stamp}\n")
message(STATUS "files DnD input/link guard ${stamp}")
